# Copia a .env.local (ignorado por git). Todas son opcionales: si faltan se usan
# los valores por defecto del proyecto actual (ver src/config/env.ts).

# URL base del backend (API REST + Socket.IO). Sin barra final.
VITE_API_BASE_URL=https://translvoz-pro-production.up.railway.app

# Configuración web de Firebase (pública por diseño; restringe por dominio en la consola).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Subtítulos traducidos en llamada. Activar SOLO cuando el backend implemente el relay call:caption.
VITE_ENABLE_CAPTIONS=false
